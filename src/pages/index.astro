---
import Layout from '~/layouts/DocumentLayout.astro';

import Undertaking from '~/components/document/Undertaking.astro';
import SignatureBlock from '~/components/document/SignatureBlock.astro';
import Clause from '~/components/document/Clause.astro';

import { caseStudies, testimonials } from '~/data/exhibits';

const metadata = {
  title: 'Garber Squared LLC: Software Delivered On Time, On Budget, On Demand',
  description:
    'Garber Squared is a software consultancy led by Alexander Garber. Fixed scope and price, dated milestones with working software, and engagements that start within days.',
  ignoreTitleTemplate: true,
};

const promises = [
  { words: 'On Time.', how: 'Dated milestones, with working software at each one.' },
  { words: 'On Budget.', how: 'Fixed scope and fixed price, agreed up front.' },
  { words: 'On Demand.', how: 'Engagements start within days.' },
];

const services = [
  {
    ref: 'A.1',
    name: 'Cross-platform application development',
    short: 'Cross-platform apps',
    text: 'Applications for web, Android and iOS.',
  },
  {
    ref: 'A.2',
    name: 'APIs and integration',
    text: 'Google Cloud, RESTful APIs and MCP.',
  },
  {
    ref: 'A.3',
    name: 'Business solutions',
    text: 'Google Workspace automation, knowledge bases and process improvements.',
  },
  {
    ref: 'A.4',
    name: 'Web development and DevOps',
    short: 'Web and DevOps',
    text: 'AWS, Heroku, Vercel, Supabase and similar platforms.',
  },
  {
    ref: 'A.5',
    name: 'Agentic AI and machine learning',
    short: 'Agentic AI and ML',
    text: 'Agent workflows that take over multi-step tasks, and models that learn from your own data.',
  },
];

const stages = [
  { ref: '2.1', name: 'Consultation', text: 'A free 30-minute call with Alexander about what you need built.' },
  {
    ref: '2.2',
    name: 'Scope and price',
    text: 'We agree what will be built and what it will cost. Both are fixed before work starts.',
  },
  { ref: '2.3', name: 'Start', text: 'Work begins within days of that agreement.' },
  { ref: '2.4', name: 'Milestones', text: 'Each milestone has a date and ends with working software you can use.' },
  { ref: '2.5', name: 'Handover', text: 'The agreed scope, delivered at the agreed price.' },
];

const exhibits = [
  {
    name: 'Code',
    text: 'Open source work by Alexander Garber:',
    href: 'https://github.com/clockworkpc/',
    linkText: 'github.com/clockworkpc',
  },
  {
    name: 'Writing',
    text: 'Engineering notes and articles:',
    href: 'https://alexandergarber.com',
    linkText: 'alexandergarber.com',
  },
  ...caseStudies.map(({ client, summary, href }) => ({
    name: client,
    text: summary,
    href,
    linkText: 'Read the case study',
  })),
].map((exhibit, index) => ({ ...exhibit, ref: `B.${index + 1}` }));
---

<Layout metadata={metadata}>
  <Undertaking
    lead="Garber Squared is a software consultancy led by Alexander Garber. We undertake to deliver your software:"
    promises={promises}
    services={services}
    stamp="FIXED PRICE"
  />

  <SignatureBlock id="sign" title="Signatures" note="for founders and CTOs ready to start" />

  <Clause
    id="how-we-work"
    num="2"
    title="How we work"
    intro="Every engagement runs through the same five stages."
    rows={stages}
    note="The number of milestones and their dates are set in your own schedule."
  />

  <Clause
    id="services"
    num="A"
    title="Schedule A: Services"
    intro="What we build for startup founders and CTOs."
    rows={services}
  />

  <Clause
    id="exhibits"
    num="B"
    title="Schedule B: Exhibits"
    intro="Alexander Garber leads Garber Squared and is the engineer you work with. His work is open to inspection."
    rows={exhibits}
  >
    {
      testimonials.length > 0 && (
        <ul class="sow-rows">
          {testimonials.map(({ quote, name, role }) => (
            <li class="sow-row">
              <blockquote class="sow-row__quote">{quote}</blockquote>
              <p class="sow-row__ref">
                {name}, {role}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </Clause>

  <SignatureBlock id="execution" title="Execution" note="the first step is a conversation" />
</Layout>
