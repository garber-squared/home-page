---
import Layout from '~/layouts/DocumentLayout.astro';
import Clause from '~/components/document/Clause.astro';
import SignatureBlock from '~/components/document/SignatureBlock.astro';

import { contactEmail } from '~/navigation';

const metadata = {
  title: 'Contact',
};

const rows = [
  { ref: 'C.1', name: 'Email', href: `mailto:${contactEmail}`, linkText: contactEmail },
  // Phone hidden until a business number is supplied.
  // { ref: 'C.2', name: 'Phone', text: '+1 (844) 524-2556' },
  { ref: 'C.2', name: 'Mailing address', text: 'P.O. Box 321, Walkersville, MD 21793, USA' },
];
---

<Layout metadata={metadata}>
  <Clause id="contact" num="C" title="Contact" rows={rows} isFirst />

  <SignatureBlock id="execution" title="Execution" note="the first step is a conversation" />
</Layout>
