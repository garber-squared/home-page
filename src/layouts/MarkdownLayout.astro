---
import Layout from '~/layouts/DocumentLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
  headings?: { depth: number }[];
}

const { frontmatter, headings = [] } = Astro.props;

// Some pages open with their own top-level heading; only add one when they do not.
const hasOwnTitle = headings.some(({ depth }) => depth === 1);

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <article class="sow-clause sow-clause--first">
    <p class="sow-num" aria-hidden="true">§</p>
    <div class="sow-clause__body sow-prose">
      {!hasOwnTitle && frontmatter?.title && <h1>{frontmatter.title}</h1>}
      <slot />
    </div>
  </article>
</Layout>
